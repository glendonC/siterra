  },
  {
   "name": "units_and_scale",
   "passed": true,
   "detail": "Reflectance = DN / 10000 for every baseline, no offset applied (four pixel-paired tests, observation-preprocessing section 2). Guard, January 2022, median red DN of kept pixels by tile, baseline before 04.00 vs 04.00 or later: 29SQR 1308 vs 1466; 29RQQ 1405 vs 1384 (scenes with at least 10000 clear pixels only; this minimum was added after the first build of this bundle flagged three cloud-covered 29RQQ scenes; fail if 500 DN or more apart)"
  },
  {
   "name": "period_alignment",
   "passed": true,
   "detail": "Each Item's observation dates fall inside its month; STAC bounds run from the first to the last second of the month"
  },
  {
   "name": "attribution_present",
   "passed": true,
   "detail": "Copernicus Sentinel notice with the actual years and the Copernicus DEM notice are in siterra:attribution"
  },
  {
   "name": "visual_inspection_sample",
   "passed": true,
   "detail": "Monthly median NDVI and clear-date counts rendered for period_2019-02, period_2019-05 and period_2023-08 and inspected by the science lane on 2026-10-27: the composites sit inside the catchment outline on the analysis grid; the green valley floor and its side valleys carry the highest values in all three months; in February 2019 snow-covered ridges and shaded north-facing slopes have no clear date, so winter coverage is biased by aspect and elevation; in May 2019 and August 2023 almost every pixel has at least 3 clear dates, with fewer dates in the east where only one orbit covers the catchment"
  }
 ],

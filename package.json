{
  "name": "siterra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --no-bail run typecheck",
    "test": "vitest run",
    "migrate": "node packages/db/src/run-migrations.ts",
    "seed:load": "node packages/db/src/run-seed.ts load concept seed",
    "build:web": "pnpm --filter @siterra/web build",
    "start:web": "pnpm --filter @siterra/web start:deploy",
    "start:worker": "node apps/worker/lib/main.ts",
    "check:pf05": "node packages/db/src/run-pf05-local.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/api": "1.9.1"
    }
  }
}

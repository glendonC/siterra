      "caption": {
        "ink": "September to May rainfall explains little of the change in March to June greenness (R squared {r2}).",
        "grey": "A straight-line fit across seasons; it measures how closely the two move together and says nothing about why.",
        "claimKind": "model_estimate",
        "citationIds": ["meas_rainfall_fit_r_squared_catchment_mar_jun"],
        "numbers": {
          "r2": {
            "measurementId": "meas_rainfall_fit_r_squared_catchment_mar_jun",
            "part": "value",
            "decimals": 3
          }
        }

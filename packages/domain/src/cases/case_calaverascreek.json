  "explanations": [
    {
      "id": "rainfall",
      "label": "Rainfall",
      "statement": "Rainfall in the wet season before each scene could have raised or lowered vegetation greenness in the catchment, depending on whether that season was wetter or drier than usual."
    },
    {
      "id": "grazing",
      "label": "Grazing",
      "statement": "Grazing on the catchment's rangeland, managed under a rangeland management plan, could have changed vegetation greenness, raising or lowering it depending on how the grazing was carried out."
    },
    {
      "id": "dam_history",
      "label": "Dam history",
      "statement": "The history of Calaveras Reservoir and Calaveras Dam, including the replacement of the dam, could have shaped vegetation greenness nearby, raising or lowering it through construction work, water levels or ground disturbance."
    },
    {
      "id": "land_cover_change",
      "label": "Land cover change",
      "statement": "A change in what covers the ground, such as brush, trees, bare soil or buildings replacing grass, or the reverse, could have raised or lowered measured greenness in parts of the catchment."
    },
    {
      "id": "data_artefact",
      "label": "Data artefact",
      "statement": "Fewer clear scenes, the satellite's overpass time or the way the images were processed could have made measured greenness look higher or lower without any change in the vegetation."
    }
  ],

# Siterra environment: every variable the web service and the worker read, with no secret values.
# On a host, set these in its secret store; credentials never go in a file (CONTRIBUTING.md).
#
# Start order on a host (no deploy, account or public URL is implied by this file):
#   pnpm install --frozen-lockfile
#   pnpm migrate          applies pending migrations to DATABASE_URL (run before web and worker)
#   pnpm seed:load        once per database: the seed case for the demo seed owner
#   pnpm build:web
#   pnpm start:web        web service; health check path: /api/health (503 until migrated)
#   pnpm start:worker     worker service, from the repository root

# --- Web and worker ---
# PostgreSQL connection string (secret store; the value below is a placeholder).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# --- Web service ---
# Interface to bind: 127.0.0.1 on a laptop, 0.0.0.0 on a hosted service.
SITERRA_BIND_HOST=127.0.0.1
# Port to listen on; a host usually sets PORT itself.
PORT=4350
# The public origin; state-changing requests are accepted only from it.
SITERRA_APP_ORIGIN=https://siterra.example.invalid
# Optional: folders of the case bundles and the map bundle; default data/bundles and data/map found
# upward from the working folder.
# SITERRA_BUNDLES_DIR=
# SITERRA_MAP_DIR=
# Map and globe manifests the interface loads (apps/web/app/page.tsx); their values follow the
# interface lane's map unit. GET /api/map-assets redirects to the current data/map manifest.
NEXT_PUBLIC_MAP_MANIFEST_URL=
NEXT_PUBLIC_GLOBE_MANIFEST_URL=
# Development only, never on a host: requests without a session act as this owner (next dev only).
# SITERRA_DEV_OWNER_SCOPE=

# --- Demo sessions (quotas are the founder's decision) ---
SITERRA_SEED_CASE_ID=case_aitbouguemez
SITERRA_SEED_OWNER_SCOPE=seed
SITERRA_DEMO_TTL_SECONDS=86400
SITERRA_DEMO_MAX_ACTIVE=50
SITERRA_DEMO_MAX_PER_MINUTE=10
SITERRA_DEMO_COMMAND_QUOTA=20

# --- Worker ---
# Repository root and corpus manifest the worker reads; defaults: the working folder and
# data/case/corpus-manifest.json.
# SITERRA_REPO_ROOT=
# SITERRA_CORPUS_MANIFEST=
# Model route: replay until GATE-01 is recorded. A replay file is labeled synthetic or recorded.
SITERRA_MODEL_ROUTE=replay
SITERRA_REPLAY_FILE=
# Live route, only after GATE-01 is recorded and the founder sets a spend cap: the approval value,
# the Model API base URL and the key (secret store only, never in a file).
# SITERRA_LIVE_APPROVED=
# SITERRA_MODEL_BASE_URL=
# MODEL_API_KEY=

# --- Telemetry (web and tools) ---
NEXT_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
